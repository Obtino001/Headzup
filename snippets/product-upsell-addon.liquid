{{ 'product-upsell-addon.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-upsell-addon.js' | asset_url | append: '?v=' | append: shop.metafields.cache.version.value | default: '1' }}" defer="defer"></script>
<script src="{{ 'complementary-products.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign heading = block.settings.heading | default: "Ofte købt sammen"
  assign accent_color = block.settings.accent_color | default: "#000000"
  assign padding_bottom = block.settings.padding_bottom | default: 16
  assign manual_products = block.settings.product_list
  assign upsell_collection = block.settings.upsell_collection
  assign upsell_limit = 5
  assign main_vendor = product.vendor | downcase | strip
  assign use_ajax = false

  if manual_products == blank and upsell_collection == blank
    assign use_ajax = true
  endif
-%}

{%- comment -%}
  Auto mode: max 1 product per brand so Von Dutch PDP shows e.g. New Era + '47 + Brixton + HUF — not 5x New Era.
{%- endcomment -%}

{%- capture upsell_items -%}
  {%- if manual_products != blank -%}
    {%- for upsell_product in manual_products limit: upsell_limit -%}
      {%- if upsell_product.id == product.id -%}{%- continue -%}{%- endif -%}
      {%- assign current_variant = upsell_product.selected_or_first_available_variant -%}
      {%- if current_variant.available -%}
        {%- render 'product-upsell-addon-item', upsell_product: upsell_product, current_variant: current_variant -%}
      {%- endif -%}
    {%- endfor -%}

  {%- elsif upsell_collection != blank -%}
    {%- assign shown_count = 0 -%}
    {%- assign shown_vendors = ',' -%}
    {%- for upsell_product in upsell_collection.products -%}
      {%- if shown_count >= upsell_limit -%}{%- break -%}{%- endif -%}
      {%- if upsell_product.id == product.id or upsell_product.available == false -%}{%- continue -%}{%- endif -%}

      {%- assign upsell_vendor = upsell_product.vendor | downcase | strip -%}
      {%- assign vendor_check = ',' | append: upsell_vendor | append: ',' -%}
      {%- if shown_vendors contains vendor_check -%}{%- continue -%}{%- endif -%}

      {%- assign current_variant = upsell_product.selected_or_first_available_variant -%}
      {%- if current_variant.available -%}
        {%- render 'product-upsell-addon-item', upsell_product: upsell_product, current_variant: current_variant -%}
        {%- assign shown_count = shown_count | plus: 1 -%}
        {%- assign shown_vendors = shown_vendors | append: upsell_vendor | append: ',' -%}
      {%- endif -%}
    {%- endfor -%}

  {%- else -%}
    {%- assign shown_count = 0 -%}
    {%- assign shown_ids = ',' | append: product.id | append: ',' -%}
    {%- assign shown_vendors = ',' -%}

    {%- comment -%} Helper: try to add product if new brand + available {%- endcomment -%}

    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      {%- for upsell_product in recommendations.products -%}
        {%- if shown_count >= upsell_limit -%}{%- break -%}{%- endif -%}

        {%- assign id_check = ',' | append: upsell_product.id | append: ',' -%}
        {%- if shown_ids contains id_check or upsell_product.available == false -%}{%- continue -%}{%- endif -%}

        {%- assign upsell_vendor = upsell_product.vendor | downcase | strip -%}
        {%- if upsell_vendor == blank -%}{%- continue -%}{%- endif -%}
        {%- if main_vendor != blank and upsell_vendor == main_vendor -%}{%- continue -%}{%- endif -%}

        {%- assign vendor_check = ',' | append: upsell_vendor | append: ',' -%}
        {%- if shown_vendors contains vendor_check -%}{%- continue -%}{%- endif -%}

        {%- assign current_variant = upsell_product.selected_or_first_available_variant -%}
        {%- if current_variant.available -%}
          {%- render 'product-upsell-addon-item', upsell_product: upsell_product, current_variant: current_variant -%}
          {%- assign shown_count = shown_count | plus: 1 -%}
          {%- assign shown_ids = shown_ids | append: upsell_product.id | append: ',' -%}
          {%- assign shown_vendors = shown_vendors | append: upsell_vendor | append: ',' -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    {%- comment -%} Fill from product collections — still 1 per brand {%- endcomment -%}
    {%- if shown_count < upsell_limit -%}
      {%- for collection in product.collections -%}
        {%- if shown_count >= upsell_limit -%}{%- break -%}{%- endif -%}
        {%- for upsell_product in collection.products -%}
          {%- if shown_count >= upsell_limit -%}{%- break -%}{%- endif -%}

          {%- assign id_check = ',' | append: upsell_product.id | append: ',' -%}
          {%- if shown_ids contains id_check or upsell_product.available == false -%}{%- continue -%}{%- endif -%}

          {%- assign upsell_vendor = upsell_product.vendor | downcase | strip -%}
          {%- if upsell_vendor == blank -%}{%- continue -%}{%- endif -%}
          {%- if main_vendor != blank and upsell_vendor == main_vendor -%}{%- continue -%}{%- endif -%}

          {%- assign vendor_check = ',' | append: upsell_vendor | append: ',' -%}
          {%- if shown_vendors contains vendor_check -%}{%- continue -%}{%- endif -%}

          {%- assign current_variant = upsell_product.selected_or_first_available_variant -%}
          {%- if current_variant.available -%}
            {%- render 'product-upsell-addon-item', upsell_product: upsell_product, current_variant: current_variant -%}
            {%- assign shown_count = shown_count | plus: 1 -%}
            {%- assign shown_ids = shown_ids | append: upsell_product.id | append: ',' -%}
            {%- assign shown_vendors = shown_vendors | append: upsell_vendor | append: ',' -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    {%- endif -%}

    {%- comment -%} Fill from catalog — 1 per brand across whole shop {%- endcomment -%}
    {%- if shown_count < upsell_limit and collections.all != blank -%}
      {%- for upsell_product in collections.all.products -%}
        {%- if shown_count >= upsell_limit -%}{%- break -%}{%- endif -%}

        {%- assign id_check = ',' | append: upsell_product.id | append: ',' -%}
        {%- if shown_ids contains id_check or upsell_product.available == false -%}{%- continue -%}{%- endif -%}

        {%- assign upsell_vendor = upsell_product.vendor | downcase | strip -%}
        {%- if upsell_vendor == blank -%}{%- continue -%}{%- endif -%}
        {%- if main_vendor != blank and upsell_vendor == main_vendor -%}{%- continue -%}{%- endif -%}

        {%- assign vendor_check = ',' | append: upsell_vendor | append: ',' -%}
        {%- if shown_vendors contains vendor_check -%}{%- continue -%}{%- endif -%}

        {%- assign current_variant = upsell_product.selected_or_first_available_variant -%}
        {%- if current_variant.available -%}
          {%- render 'product-upsell-addon-item', upsell_product: upsell_product, current_variant: current_variant -%}
          {%- assign shown_count = shown_count | plus: 1 -%}
          {%- assign shown_ids = shown_ids | append: upsell_product.id | append: ',' -%}
          {%- assign shown_vendors = shown_vendors | append: upsell_vendor | append: ',' -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endif -%}
{%- endcapture -%}

{%- if use_ajax -%}
  <complementary-products
    class="complementary-products"
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=50&intent=related"
  >
    {%- if upsell_items != blank -%}
      <upsell-addon
        class="product__block upsell-addon block-padding"
        data-main-product-price="{{ product.selected_or_first_available_variant.price | default: 0 }}"
        style="--upsell-accent: {{ accent_color }}; --block-padding-bottom: {{ padding_bottom }}px;"
        {{ block.shopify_attributes }}
      >
        {%- if heading != blank -%}
          <h3 class="upsell-addon__heading">{{ heading }}</h3>
        {%- endif -%}
        <div class="upsell-addon__list">{{ upsell_items }}</div>
        <div class="upsell-addon__footer">
          <div class="upsell-addon__total-price-wrapper">
            <span>I alt:</span>
            <span data-upsell-total>0,00 kr</span>
          </div>
        </div>
      </upsell-addon>
    {%- endif -%}
  </complementary-products>
{%- elsif upsell_items != blank -%}
  <upsell-addon
    class="product__block upsell-addon block-padding"
    data-main-product-price="{{ product.selected_or_first_available_variant.price | default: 0 }}"
    style="--upsell-accent: {{ accent_color }}; --block-padding-bottom: {{ padding_bottom }}px;"
    {{ block.shopify_attributes }}
  >
    {%- if heading != blank -%}
      <h3 class="upsell-addon__heading">{{ heading }}</h3>
    {%- endif -%}
    <div class="upsell-addon__list">{{ upsell_items }}</div>
    <div class="upsell-addon__footer">
      <div class="upsell-addon__total-price-wrapper">
        <span>I alt:</span>
        <span data-upsell-total>0,00 kr</span>
      </div>
    </div>
  </upsell-addon>
{%- endif -%}
