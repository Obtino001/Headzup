{% assign breadcrumbs_modifier = breadcrumbs_modifier | default: '' %}

{% capture divider_html %}
  <span class="breadcrumbs__arrow">&nbsp;</span>
{% endcapture %}

<nav class="breadcrumbs {{ breadcrumbs_modifier }}">
  <a href="{{ routes.root_url }}" class="breadcrumbs__link breadcrumbs__link--home">{{ 'general.breadcrumbs.home' | t }}</a>

  {{ divider_html }}

  {% if template contains 'product' %}
    {%- if collection -%}
      <a href="{{ collection.url }}" class="breadcrumbs__link">{{ collection.title }}</a>

      {{ divider_html }}
    {%- endif -%}
  {%- elsif template.name == 'article' -%}
    <a href="{{ blog.url }}" class="breadcrumbs__link">{{ blog.title }}</a>

    {{ divider_html }}
  {% endif %}

  <span class="breadcrumbs__current">{{- page_title -}}</span>
</nav>