{%- comment -%}
  Hidden stub only — Assortion is the real cart UI.
  Stub keeps AJAX add-to-cart working (no page refresh to /cart).
{%- endcomment -%}
{%- if template.name != 'cart' -%}
  <div
    data-section-id="{{ section.id }}"
    data-section-type="cart-drawer"
    hidden
    aria-hidden="true"
    style="display:none!important;position:absolute;width:0;height:0;overflow:hidden;pointer-events:none;"
  >
    <cart-drawer
      id="cart-drawer"
      class="drawer drawer--cart is-empty"
      aria-hidden="true"
      data-headzup-cart-stub
      style="display:none!important;"
    >
      <cart-items style="display:none!important;"></cart-items>
    </cart-drawer>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "paragraph",
      "content": "Hidden stub for AJAX add-to-cart. Assortion shows the real cart. Keep enabled to avoid page refresh."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme_1",
      "label": "Color scheme"
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Cart"
        }
      ]
    },
    {
      "type": "products",
      "name": "Products",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "pin_to_bottom",
          "label": "Pin to bottom",
          "default": false
        }
      ]
    },
    {
      "type": "checkout-buttons",
      "name": "Checkout buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "pin_to_bottom",
          "label": "Pin to bottom",
          "default": true
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["aside"]
  }
}
{% endschema %}
