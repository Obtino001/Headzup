{%- comment -%}
  Theme cart drawer UI is disabled — Rebuy Smart Cart is the only cart.
  We keep an empty <cart-drawer> stub so theme ATC JS still finds this.cart
  and does not redirect to /cart. No underlay = no ghost blur after closing Rebuy.
{%- endcomment -%}
{%- if template.name != 'cart' -%}
  <div
    data-section-id="{{ section.id }}"
    data-section-type="cart-drawer"
    hidden
    aria-hidden="true"
    style="display: none !important;"
  >
    <cart-drawer
      class="drawer drawer--cart is-empty"
      id="cart-drawer"
      aria-hidden="true"
      style="display: none !important;"
    ></cart-drawer>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "paragraph",
      "content": "Theme cart drawer UI is disabled. Rebuy Smart Cart handles the cart. Keep this section enabled so add-to-cart works without page refresh."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme_1",
      "label": "Color scheme"
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Cart"
        }
      ]
    },
    {
      "type": "free-shipping",
      "name": "Free shipping",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "message",
          "label": "Message"
        },
        {
          "type": "checkbox",
          "id": "pin_to_bottom",
          "label": "Pin to bottom",
          "default": false
        }
      ]
    },
    {
      "type": "products",
      "name": "Products",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "pin_to_bottom",
          "label": "Pin to bottom",
          "default": false
        }
      ]
    },
    {
      "type": "upsell-products",
      "name": "Upsell products",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "upsell_auto_open",
          "label": "Auto open",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "pin_to_bottom",
          "label": "Pin to bottom",
          "default": false
        }
      ]
    },
    {
      "type": "checkout-buttons",
      "name": "Checkout buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "pin_to_bottom",
          "label": "Pin to bottom",
          "default": true
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["aside"]
  }
}
{% endschema %}
