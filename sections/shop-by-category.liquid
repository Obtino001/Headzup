

<style>
  #sbc-{{ section.id }} {
    --font: var(--FONT-STACK-HEADING);
    --bg: {{ section.settings.background_color }};
    --text: #1A1A1A;
    --radius: {{ section.settings.border_radius }}px;
    --card-w: {{ section.settings.card_width }}px;
    --card-h: {{ section.settings.card_height }}px;
    --label-size: {{ section.settings.label_font_size }}px;
  }

  #sbc-{{ section.id }} {
    background: var(--bg);
    padding: {{ section.settings.padding_top }}px clamp(16px, 5vw, 40px) {{ section.settings.padding_bottom }}px;
  }

  #sbc-{{ section.id }} .sbc-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 28px;
  }

  #sbc-{{ section.id }} .sbc-head-left {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  #sbc-{{ section.id }} .sbc-eyebrow {
    font-family: var(--font);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #A0AFA0;
    display: block;
  }


  #sbc-{{ section.id }} .sbc-arrows {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
    margin-bottom: 4px;
  }

  #sbc-{{ section.id }} .sbc-arrow {
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s;
    width: 32px;
    height: 32px;
    padding: 0;
  }

  #sbc-{{ section.id }} .sbc-arrow:hover {
    opacity: 0.6;
  }

  #sbc-{{ section.id }} .sbc-arrow svg {
    width: 18px;
    height: 18px;
  }

  #sbc-{{ section.id }} .sbc-arrow.swiper-button-disabled {
    opacity: 0.3;
    cursor: default;
  }

  #sbc-{{ section.id }} .sbc-outer {
    width: 100%;
    overflow: visible !important;
  }

  /* Clean fast fallback before swiper kicks in */
  #sbc-swiper-{{ section.id }}:not(.swiper-initialized) .swiper-wrapper {
    display: flex;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    gap: 12px;
  }
  #sbc-swiper-{{ section.id }}:not(.swiper-initialized) .swiper-wrapper::-webkit-scrollbar {
    display: none;
  }
  #sbc-swiper-{{ section.id }}:not(.swiper-initialized) .swiper-slide {
    width: var(--card-w);
    flex-shrink: 0;
  }

  #sbc-{{ section.id }} .sbc-card {
    flex-shrink: 0;
    width: var(--card-w);
    height: var(--card-h);
    border-radius: var(--radius);
    overflow: hidden;
    position: relative;
    display: block;
    text-decoration: none;
    background: #EDEAE4;
  }

  #sbc-{{ section.id }} .sbc-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  #sbc-{{ section.id }} .sbc-card:hover img {
    transform: scale(1.04);
  }

  #sbc-{{ section.id }} .sbc-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0,0,0,0.52) 0%,
      rgba(0,0,0,0.08) 55%,
      rgba(0,0,0,0) 100%
    );
    z-index: 1;
  }

  #sbc-{{ section.id }} .sbc-label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 2;
    padding: 16px 18px;
  }

  #sbc-{{ section.id }} .sbc-label-text {
    font-family: var(--font);
    font-size: var(--label-size);
    font-weight: 500;
    color: #fff;
    display: block;
    border-bottom: 1.5px solid rgba(255,255,255,0.6);
    padding-bottom: 3px;
    width: fit-content;
    letter-spacing: 0.01em;
    transition: border-color 0.2s;
  }

  #sbc-{{ section.id }} .sbc-card:hover .sbc-label-text {
    border-color: #fff;
  }

  #sbc-{{ section.id }} .sbc-badge {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 3;
    background: {{ section.settings.badge_color }};
    color: {{ section.settings.badge_text_color }};
    font-family: var(--font);
    font-size: 11px;
    font-weight: 600;
    line-height: 1.3;
    text-align: center;
    padding: 10px 12px;
    border-radius: 50%;
    width: 58px;
    height: 58px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #sbc-{{ section.id }} .sbc-placeholder {
    position: absolute;
    inset: 0;
    background: #2A2A2A;
  }

  #sbc-{{ section.id }} .sbc-placeholder svg {
    width: 100%;
    height: 100%;
    opacity: 0.12;
  }

  @media (max-width: 640px) {
    #sbc-{{ section.id }} .sbc-card, #sbc-swiper-{{ section.id }}:not(.swiper-initialized) .swiper-slide {
      width: 72vw;
      height: 88vw;
    }
    #sbc-{{ section.id }} .sbc-outer {
      margin-left: calc(-1 * clamp(16px, 5vw, 40px));
      margin-right: calc(-1 * clamp(16px, 5vw, 40px));
      padding-left: clamp(16px, 5vw, 40px);
      padding-right: clamp(16px, 5vw, 40px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #sbc-{{ section.id }} .sbc-card img {
      transition: none !important;
    }
  }
</style>

<section id="sbc-{{ section.id }}">

  <div class="sbc-head">
    <div class="sbc-head-left">
      {% if section.settings.eyebrow != blank %}
        <span class="sbc-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="insp-title">{{ section.settings.title }}</h2>
      {% endif %}
    </div>

    <div class="sbc-arrows">
      <button class="sbc-arrow" id="sbc-prev-{{ section.id }}" aria-label="Previous">
        {% render 'icon-arrow-left' %}
      </button>
      <button class="sbc-arrow" id="sbc-next-{{ section.id }}" aria-label="Next">
        <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-arrow-right" viewBox="0 0 24 24"><path d="M5.5 12h12m0 0-6-6m6 6-6 6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  </div>

  <div class="sbc-outer swiper" id="sbc-swiper-{{ section.id }}">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        {% if block.type == 'card' %}
          <a class="sbc-card swiper-slide"
             href="{{ block.settings.link | default: '#' }}"
             {{ block.shopify_attributes }}>

            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.image.alt | default: block.settings.label, draggable: 'false' }}
            {% else %}
              <div class="sbc-placeholder">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            {% endif %}

            <div class="sbc-overlay"></div>

            {% if block.settings.badge != blank %}
              <div class="sbc-badge">{{ block.settings.badge }}</div>
            {% endif %}

            {% if block.settings.label != blank %}
              <div class="sbc-label">
                <span class="sbc-label-text">{{ block.settings.label }}</span>
              </div>
            {% endif %}

          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>

</section>

<script>
(function () {
  function initSwiper() {
    if (typeof Swiper !== 'undefined') {
      new Swiper('#sbc-swiper-{{ section.id }}', {
        slidesPerView: 'auto',
        spaceBetween: 12,
        navigation: {
          nextEl: '#sbc-next-{{ section.id }}',
          prevEl: '#sbc-prev-{{ section.id }}',
        },
        grabCursor: true,
      });
    } else {
      setTimeout(initSwiper, 100);
    }
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSwiper);
  } else {
    initSwiper();
  }
})();
</script>
{% schema %}
{
  "name": "Shop by Category",
  "tag": "section",
  "class": "shop-by-category-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text (Small text above title)",
      "default": "Favoritter"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop efter kategori"
    },
    {
      "type": "range",
      "id": "label_font_size",
      "label": "Category Name Font Size",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card Width (Desktop)",
      "min": 180,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 280
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Card Height (Desktop)",
      "min": 200,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 340
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border Radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FAF7F3"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge Color",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Category Name",
          "placeholder": "Trucker Caps"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge Text (Optional)",
          "placeholder": "Up to 40% Off",
          "info": "Displays as a circle on the top right"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Category",
      "blocks": [
        { "type": "card", "settings": { "label": "Trucker Caps" } },
        { "type": "card", "settings": { "label": "Snapbacks" } },
        { "type": "card", "settings": { "label": "59FIFTY Fitted Caps" } },
        { "type": "card", "settings": { "label": "Baseball Caps" } },
        { "type": "card", "settings": { "label": "Caps til kvinder" } }
      ]
    }
  ]
}
{% endschema %}